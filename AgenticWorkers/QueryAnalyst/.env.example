# Copy this file to .env and fill in your values

# LLM APIs
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Puter AI for image analysis (get token from https://puter.com/dashboard)
PUTER_AUTH_TOKEN=your_puter_auth_token

# Supabase (Main database for grievances)
SUPABASE_DB_PASSWORD=your_supabase_password
SUPABASE_DSN=postgresql://postgres.xxxx:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Neon DB - Fraud Vector Database (ONLY for online fraud cases)
NEON_DSN=postgresql://user:pass@fraud-db-host.neon.tech/fraud_cases?sslmode=require

# Neon DB connection strings (historical/policy data)
NEON_DB_1_URL=postgresql://user:pass@host/database1?sslmode=require
NEON_DB_2_URL=postgresql://user:pass@host/database2?sslmode=require
NEON_DB_3_URL=postgresql://user:pass@host/database3?sslmode=require
NEON_DB_4_URL=postgresql://user:pass@host/database4?sslmode=require
NEON_DB_5_URL=postgresql://user:pass@host/database5?sslmode=require
NEON_DB_7_URL=postgresql://user:pass@host/database7?sslmode=require

# Azure Storage (for queue and blob)
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_QUEUE_NAME=queryanalyst
AZURE_WEBCRAWLER_QUEUE_NAME=webcrawler
AZURE_STORAGE_CONTAINER_NAME=test
